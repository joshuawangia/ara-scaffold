{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audit_essay",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sentence": {
            "type": "integer",
            "minimum": 1
          },
          "node_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "asserts_unlisted_content": {
            "type": "boolean"
          }
        },
        "required": [
          "sentence",
          "node_ids",
          "asserts_unlisted_content"
        ]
      }
    }
  },
  "required": [
    "labels"
  ]
}

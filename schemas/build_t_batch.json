              "const": "forall"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/formula"
              },
              "minItems": 1,
              "maxItems": 1
            },
            "name": {
              "type": "null"
            },
            "terms": {
              "type": "array",
              "maxItems": 0

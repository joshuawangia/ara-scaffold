            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/formula"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "name": {
              "type": "null"
            },
            "terms": {
              "type": "array",
              "maxItems": 0

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "build_t_batch_v3",
  "type": "object",
  "properties": {
    "commitments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commitment"
      }
    },
    "new_symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "atom",
              "predicate",
              "constant"
            ],
            "type": "string"
          },
          "arity": {
            "type": "integer",
            "minimum": 0
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "kind",
          "arity",
          "definition",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "alignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "commitments",
    "new_symbols",
    "alignments"
  ],
  "additionalProperties": false,
  "$defs": {
    "commitment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "open"
          }
        },
        "formula": {
          "$ref": "#/$defs/formula"
        }
      },
      "required": [
        "id",
        "formula"
      ],
      "additionalProperties": false
    },
    "formula": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "atom"
            },
            "args": {
              "type": "array",
              "maxItems": 0
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "terms": {
              "type": "array",
              "maxItems": 0
            },
            "variable": {
              "type": "null"
            }
          },
          "required": [
            "op",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "not"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/formula"
              },

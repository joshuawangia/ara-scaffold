{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "extract_paper_v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "coverage_complete": {
      "type": "boolean"
    },
    "unresolved_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": [
              "premise",
              "inference",
              "intermediate_conclusion",
              "conclusion",
              "distinction",
              "qualification",
              "reported_view",
              "attacked_view"
            ]
          },
          "attribution": {
            "type": "string",
            "enum": [
              "author_claim",
              "reported_view",
              "attacked_view"
            ]
          },
          "attributed_to": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "page_start": {
            "type": "integer",
            "minimum": 1
          },
          "page_end": {
            "type": "integer",
            "minimum": 1
          },
          "premise_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "conclusion_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "qualification_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "inference_origin": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "paper_stated"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "source_id",
          "kind",
          "attribution",
          "attributed_to",
          "text",
          "page_start",
          "page_end",
          "premise_ids",
          "conclusion_id",
          "qualification_ids",
          "applies_to",
          "inference_origin"
        ]
      }
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "obligation_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "obligation_id",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "coverage_complete",
    "unresolved_references",
    "items"
  ]
}

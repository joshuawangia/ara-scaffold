{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "extract_paper",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "items"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "kind",
          "attribution",
          "text",
          "page_start",
          "page_end"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": [
              "claim",
              "argument"
            ]
          },
          "attribution": {
            "type": "string",
            "enum": [
              "author_claim",
              "reported_view",
              "attacked_view"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "page_start": {
            "type": "integer",
            "minimum": 1
          },
          "page_end": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "maxItems": 4
    }
  }
}

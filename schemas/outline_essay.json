{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "outline_essay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "sections"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "heading",
          "purpose",
          "word_budget",
          "node_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "word_budget": {
            "type": "integer",
            "minimum": 50,
            "maximum": 1200
          },
          "node_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

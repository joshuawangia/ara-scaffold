      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "covered": {
            "type": "boolean"
          },
          "handles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "covered",
          "handles",
          "missing",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "coverage"
  ],
  "additionalProperties": false
}

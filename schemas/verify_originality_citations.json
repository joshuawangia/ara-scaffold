{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verify_originality_citations",
  "type": "object",
  "properties": {
    "originality": {
      "type": "object",
      "properties": {
        "assessment": {
          "type": "string",
          "enum": [
            "no_match",
            "possible_overlap",
            "unverified"
          ]
        },
        "evidence_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "assessment",
        "evidence_urls",
        "detail"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "citation",
              "quotation"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified"
            ]
          },
          "evidence_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "retain",
              "remove"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "status",
          "evidence_urls",
          "detail",
          "action"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "verified"
                }
              }
            },
            "then": {
              "properties": {
                "action": {
                  "const": "retain"
                },
                "evidence_urls": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "action": {
                  "const": "remove"
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "originality",
    "items"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "write_essay",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "bibliography": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "url"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "title",
    "body",
    "bibliography"
  ],
  "additionalProperties": false
}
